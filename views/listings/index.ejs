
<% layout("/layouts/boilerplate") %>

<style>
  .filter {
    text-align: center;
    margin-right: 2rem;
    margin-top: 1rem;
    opacity: 0.7;
    transition: opacity 0.2s ease, border-bottom 0.2s ease;
  }

  .filter:hover {
    opacity: 1;
    cursor: pointer;
  }

  .filter.active {
    opacity: 1;
    border-bottom: 2px solid black;
  }

  .filter p {
    font-size: 0.9rem;
  }

  .tax-info {
    display: none;
  }
  /* .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    padding: 0.6rem 1rem;
    height: auto;
    display: inline-block;
    margin: 1rem 0 0 1rem;
  } */

  .tax-toggle {
    border: 1px solid black;
    border-radius: 1rem;
    padding: 1rem;
    height: 3.5rem;
    margin-left: 10rem;
   
  }

  .carousel-control-prev-icon,
  .carousel-control-next-icon {
    background-color: black;
    border-radius: 50%;
    padding: 0.5rem;
  }

  .carousel-item .d-flex {
    overflow-x: auto;
    scrollbar-width: none;
  }

  .carousel-item .d-flex::-webkit-scrollbar {
   
    display: none;  
  }
</style>

<body>

  <!-- ✅ Fixed Carousel -->
  <div id="filterCarousel" class="carousel slide" data-bs-ride="carousel" data-bs-interval="4000">
    <div class="carousel-inner">

      <!-- Slide 1 -->
      <div class="carousel-item active">
        <div class="d-flex justify-content-around flex-wrap">
          <div class="filter active"><i class="fa-solid fa-fire"></i><p>Trending</p></div>
          <div class="filter"><i class="fa-solid fa-bed"></i><p>Rooms</p></div>
          <div class="filter"><i class="fa-solid fa-mountain-city"></i><p>Iconic Cities</p></div>
          <div class="filter"><i class="fa-solid fa-mountain"></i><p>Mountains</p></div>
          <div class="filter"><i class="fa-brands fa-fort-awesome"></i><p>Castles</p></div>
        </div>
      </div>

      <!-- Slide 2 -->
      <div class="carousel-item">
        <div class="d-flex justify-content-around flex-wrap">
          <div class="filter"><i class="fa-solid fa-person-swimming"></i><p>Amazing Pools</p></div>
          <div class="filter"><i class="fa-solid fa-route"></i><p>Camping</p></div>
          <div class="filter"><i class="fa-solid fa-wheat-awn"></i><p>Farms</p></div>
          <div class="filter"><i class="fa-regular fa-snowflake"></i><p>Arctic</p></div>
          <div class="filter"><i class="fa-solid fa-umbrella-beach"></i><p>Beaches</p></div>
        </div>
      </div>

    </div>

    <!-- Controls -->
    <button class="carousel-control-prev" type="button" data-bs-target="#filterCarousel" data-bs-slide="prev">
      <span class="carousel-control-prev-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Previous</span>
    </button>
    <button class="carousel-control-next" type="button" data-bs-target="#filterCarousel" data-bs-slide="next">
      <span class="carousel-control-next-icon" aria-hidden="true"></span>
      <span class="visually-hidden">Next</span>
    </button>
  </div>

  <!-- Tax Toggle -->
  <div class="tax-toggle">
    <div class="form-check form-check-reverse">
      <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
      <label class="form-check-label" for="switchCheckDefault">Display total after taxes</label>
    </div>
  </div>

  <!-- Listing Cards -->
  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">
    <% for (let listing of allListings) { %>
      <a href="/listings/<%= listing._id %>" class="listing-link text-decoration-none text-dark">
        <div class="card listing-card mb-4">
          <img
            src="<%= listing.image && listing.image.url ? listing.image.url : 'https://via.placeholder.com/400x300?text=No+Image' %>"
            class="card-img-top"
            alt="listing_image"
            style="height: 20rem; object-fit: cover;"
          >
          <div class="card-body">
            <p class="card-text mb-0">
              <b><%= listing.title %></b> <br>
              &#8377; <%= listing.price.toLocaleString("en-IN") %> /night
              <i class="tax-info"> + 18% GST</i>
            </p>
          </div>
        </div>
      </a>
    <% } %>
  </div>

  <!-- Script -->
  <script>
    // Tax toggle
    const taxSwitch = document.getElementById('switchCheckDefault');
    taxSwitch.addEventListener("change", () => {
      document.querySelectorAll('.tax-info').forEach(info => {
        info.style.display = taxSwitch.checked ? "inline" : "none";
      });
    });

    // Active filter highlight
    document.querySelectorAll('.filter').forEach(filter => {
      filter.addEventListener('click', () => {
        document.querySelectorAll('.filter').forEach(f => f.classList.remove('active'));
        filter.classList.add('active');
      });
    });
  </script>

  <!-- ✅ Include Bootstrap JS -->
  <!-- <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script> -->
</body>


















